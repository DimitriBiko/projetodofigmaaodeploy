# Gooday — variáveis de ambiente (NÃO commitar o arquivo .env)
# Copie este arquivo: cp .env.example .env e preencha os valores reais.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Compatível com docs/libs que usam nomes sem VITE_
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Preencha no Dashboard → Project Settings → Database (Connection string)
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Opcional (somente server/Edge) — NÃO exponha no frontend / NÃO committe
# SUPABASE_SERVICE_ROLE_KEY=

# Contas demo (seed)
# DEMO_EMAIL=marcos@gooday.app
# DEMO_PASSWORD=
